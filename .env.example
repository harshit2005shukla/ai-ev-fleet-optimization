# PostgreSQL connection string (matches drizzle.config.json for Option A local setup; also works on Render)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional AWS S3 Cloud Storage (leave blank to use automatic local storage fallback)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Production CORS configuration (comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:3000

# Local directory for serialized ML model artifacts
MODEL_PATH=data/models
